# Both Python services read .env from the repository root.
MOTHER_SERVER_BASE_URL=http://127.0.0.1:8001
# Development mock only. Both services must use the same value.
SERVICE_SECRET=lucky-rooms-development-only
FRONTEND_ORIGIN=http://localhost:5173

# Vite reads only VITE_* variables from this same root .env.
VITE_API_BASE_URL=http://localhost:8000
